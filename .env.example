# APP_ENV: test | development | production. If unset the app treats itself as PRODUCTION and fails closed.
APP_ENV=development
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"   (placeholders are rejected outside APP_ENV=test)
PHONE_HASH_SALT=
DATABASE_URL=sqlite:///./lab.db            # production requires postgresql+psycopg://...
# Privacy-preserving capture is the default. full_body_pii_debug stores PII: lab debugging only, forbidden in production.
CAPTURE_MODE=metadata
STORE_CALL_TRANSCRIPTS=0                   # 1 only for supervised lab analysis with fictional data; forbidden in production
# ALLOWED_SOURCE_IPS=4.213.167.70          # enable once captures confirm Sarvam's egress IP
TRUST_PROXY=0                              # 1 behind ngrok / a reverse proxy
TOOL_TIMEOUT_S=2.5
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
